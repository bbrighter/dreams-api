{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test",
            "type": "shell",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "command": "go test -v ./... -coverprofile cover.out",
            "icon": {"id": "beaker"}
        },
        {
            "label": "Test with coverage",
            "type": "shell", 
            "group": "test",
            "command": "go tool cover -html cover.out",
            "dependsOn": "Test",
            "icon": {"id": "light-bulb"},
        },
        {
            "label": "Create OpenAPI Spec",
            "type": "shell",
            "command": "export PATH=$PATH:$(go env GOPATH)/bin && swag init",
        }
    ]
}
